# Apenas exemplo: copie no File Manager para htdocs/.env e preencha o MySQL
# NÃO publique o arquivo .env real nem compartilhe prints dele.
APP_DEBUG=0
# InfinityFree na raiz do domínio: deixe vazio. Em XAMPP /agrovigia-ro.
APP_BASE_URL=
DB_HOST=HOST_MYSQL_DO_INFINITYFREE
DB_PORT=3306
DB_NAME=NOME_COMPLETO_COM_PREFIXO
DB_USER=USUARIO_MYSQL
DB_PASS=SENHA_MYSQL_PRIVADA
